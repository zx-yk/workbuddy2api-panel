# syntax=docker/dockerfile:1
#
# prebuilt：不在容器里编译，直接装本地交叉编译好的 linux/amd64 产物。
#
# 为什么需要它：主 Dockerfile 的 build 阶段要跑 go build，Go 编译峰值内存约
# 800M~1.2G。低内存机器上 docker build 极易 OOM（swap 也会被拖死），而产物本身
# 只有 24M。所以改成「本地/CI 编好 → 只 COPY」。
#
# 构建上下文由 scripts/build-image-prebuilt.sh 组装（bin/ + 脚本 + example 配置），
# 不要直接 `docker build .`——根目录上下文里没有 bin/linux-amd64/ 这个布局。
#
#   ./scripts/build-image-prebuilt.sh workbuddy2api-panel:1.14.3-integrated
#
FROM alpine:3.20
# apk 源默认走阿里云：dl-cdn.alpinelinux.org 在国内实测 12s 起（甚至挂住，
# 一次 build 卡 13 分钟），mirrors.aliyun.com 是 0.2s。国外构建可
# --build-arg APK_MIRROR=dl-cdn.alpinelinux.org 覆盖。
ARG APK_MIRROR=mirrors.aliyun.com
# python3：login.sh 的 JSON 解析 / 签到 / 落盘；bash：shell 脚本体。
RUN sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories \
 && apk add --no-cache wget ca-certificates tzdata python3 bash \
 && adduser -D -u 10001 app \
 && mkdir -p /app/auths /app/data \
 && chown -R app:app /app
WORKDIR /app
# 二进制以 root 拷入后是不可写、可执行的；运行用户为 app（与主 Dockerfile 一致）
COPY bin/wb2api /app/wb2api
COPY bin/signin_bin /app/signin_bin
COPY bin/login /app/login
COPY bin/credit /app/credit
COPY login.sh signin.sh credit.sh /app/
COPY scripts/probe_active.py /app/scripts/probe_active.py
RUN sed -i 's/\r$//' /app/login.sh /app/signin.sh /app/credit.sh \
 && chmod 755 /app/login.sh /app/signin.sh /app/credit.sh \
 && chmod 755 /app/wb2api /app/signin_bin /app/login /app/credit
# 镜像不带真实配置：落 example 作为默认（生产由挂载卷 /app/config.json 覆盖）
COPY config.example.json /app/config.json
USER app
EXPOSE 7863
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:7863/healthz || exit 1
ENTRYPOINT ["/app/wb2api", "-config", "/app/config.json"]
